// Calculate study time

function calculateStudyTime(totalTime) {

    const study =
        Math.floor(totalTime * 0.6);

    const practice =
        Math.floor(totalTime * 0.3);

    const revision =
        Math.floor(totalTime * 0.1);

    return {
        study,
        practice,
        revision
    };

}


// Validate user input

function validateInput(
    subject,
    topic
) {

    if (!subject || !topic) {

        return false;

    }

    return true;

}


// Progress calculation

function updateProgress(
    currentProgress
) {

    let progress =
        currentProgress + 20;

    if (progress > 100) {

        progress = 100;

    }

    return progress;

}


